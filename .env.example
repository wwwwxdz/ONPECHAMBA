# Token de tu bot de Telegram (proporcionado por @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Tu Chat ID personal o ID del grupo/canal (puedes obtenerlo hablando con @userinfobot)
TELEGRAM_CHAT_ID=123456789

# Frecuencia de chequeo en formato cron (por defecto cada 30 minutos)
CRON_SCHEDULE=*/30 * * * *

# ID de la ODPE en el portal de la ONPE (85 = SANTA)
ONPE_ID_ODP=85
ONPE_ODP_NOMBRE=SANTA

# Ruta del archivo de persistencia
DATA_PATH=./data/seen_ids.json
PLAYWRIGHT_HEADLESS=true
